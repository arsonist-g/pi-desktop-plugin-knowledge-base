# 复制成 .env 再改。这个文件里的值全都是必填项以外的默认值，改完不要提交。

### ---------- 服务端 ----------
HOST=0.0.0.0
PORT=9621
# 必填。生成一个长得像密码的随机串；WebUI 登录和插件都用它。
LIGHTRAG_API_KEY=change-me-to-a-long-random-string

WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

### ---------- LLM：入库抽实体用 ----------
LLM_BINDING=openai
# 任何 OpenAI 兼容端点都行：OpenAI、DeepSeek、硅基流动、本地 Ollama……
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-xxxxxxxx
LLM_MODEL=gpt-4o-mini
# 大模型慢就把超时放大；并发别太高，2 核机器上 2 就够了。
LLM_TIMEOUT=300
MAX_ASYNC_LLM=2

### ---------- Embedding：向量检索用 ----------
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_BINDING_API_KEY=sk-xxxxxxxx
# bge-m3 是 1024 维。换模型记得同步改 EMBEDDING_DIM。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=60

### ---------- 存储：内嵌，不需要外部数据库 ----------
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

### ---------- 文档解析 ----------
# official = 用 mineru.net 云 API（需要 token）；local = 自建 MinerU 服务。
# 没有 token 就先留 local，mineru 规则会被自动跳过，PDF 退化为纯文本抽取。
MINERU_API_MODE=official
MINERU_API_TOKEN=
MINERU_OFFICIAL_ENDPOINT=https://mineru.net
MINERU_LANGUAGE=ch
# native 管 docx/md，mineru 管 pdf/图片/Office，legacy 兜底。
LIGHTRAG_PARSER=*:native-iteP,*:mineru-iteP,*:legacy-R

### ---------- 抽取输出 ----------
# English / Chinese / French / German …
SUMMARY_LANGUAGE=Chinese
